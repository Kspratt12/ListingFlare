# ──────────────────────────────────────────────────
# ListingFlare Environment Variables
# Copy this file to .env.local and fill in the values
# ──────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SETUP_PRICE_ID=price_...
STRIPE_MONTHLY_PRICE_ID=price_...

# Anthropic (AI features)
ANTHROPIC_API_KEY=sk-ant-...

# App URL (used for redirects, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=re_...

# Secret that protects cron jobs and server-to-server calls (any long random string).
# Set the same value in Vercel. Without it, lead notification routes stay unprotected.
CRON_SECRET=

# Optional: override the Claude model. Defaults to claude-sonnet-5-5 in src/lib/ai.ts.
ANTHROPIC_MODEL=
# Optional: set to 1 to pause the trial welcome / day-3 / day-12 emails.
DISABLE_TRIAL_LIFECYCLE=

# Email: from address, and the secret used to verify inbound reply webhooks.
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Google Calendar connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push notifications (generate with scripts/generate-vapid.mjs).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
